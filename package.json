  "description": "Simple OCPP Virtual Charging Point",
  "scripts": {
    "lint": "biome lint src start.ts",
    "format": "biome format src start.ts",
    "typecheck": "tsc --noEmit --esModuleInterop --skipLibCheck src/**/*.ts",
    "check": "npm run lint && npm run format && npm run typecheck",
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
