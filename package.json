    "@hono/zod-validator": "^0.4.3",
    "ajv": "^6.12.6",
    "basic-ftp": "^5.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.6.1",
    "hono": "^4.11.4",
    "typescript": "^5.9.3",
    "uuid": "^8.3.2",
    "winston": "^3.19.0",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^25.0.7",
